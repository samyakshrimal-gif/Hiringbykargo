# Claude: scores CVs, writes interview briefs and emails, extracts the success pattern.
# Without it the app falls back to a crude keyword heuristic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase: persistent storage. Without it, data is kept in .data/db.json (local dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: sends the invite/rejection when you decide. Without it, sends are simulated.
RESEND_API_KEY=
RESEND_FROM="Kargo Hiring <onboarding@resend.dev>"
# Until you verify a domain, Resend only delivers to your own address, so put it here.
EMAIL_TEST_RECIPIENT=

# Password-protects the deployed app (CVs are personal data). Strongly recommended on Vercel.
APP_PASSWORD=
